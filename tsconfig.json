{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "sourceMap": true,
    "rootDir": "./src/",
    "outDir": "./dist/",
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": ["src/index.ts"],
}